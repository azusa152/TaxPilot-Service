# Database
DATABASE_URL=postgresql+asyncpg://taxpilot:taxpilot_dev@db:5432/taxpilot
POSTGRES_USER=taxpilot
POSTGRES_PASSWORD=taxpilot_dev
POSTGRES_DB=taxpilot

# Application
LOG_LEVEL=INFO

# Ports (host-side — change these to avoid conflicts with other services)
POSTGRES_PORT=5432
API_PORT=8000
ADMIN_PORT=8501
FRONTEND_PORT=3000

# LLM Gateway (Phase 6A)
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4o
LLM_API_TOKEN=
LLM_ENCRYPTION_KEY=
LLM_MONTHLY_BUDGET_USD=50.00

# NTA Crawler (Phase 6B)
NTA_CRAWL_INTERVAL_HOURS=24
NTA_CRAWL_RATE_LIMIT_SECONDS=2

# MOF Tax Reform Monitor (Layer 2)
MOF_CRAWL_INTERVAL_HOURS=168
MOF_REFORM_URL=https://www.mof.go.jp/tax_policy/tax_reform/outline/index.html

# e-Gov Law API (Layer 3)
EGOV_API_BASE_URL=https://laws.e-gov.go.jp/api/2
EGOV_CRAWL_INTERVAL_HOURS=720
EGOV_INCOME_TAX_LAW_ID=340AC0000000033
EGOV_LOCAL_TAX_LAW_ID=325AC0000000226
